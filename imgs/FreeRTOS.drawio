        <mxCell id="mtMabUNgsPTIBse-VZeg-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;2. 任务调度节奏&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RTOS 每次 Tick 会检查：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;哪个任务该唤醒&lt;/div&gt;&lt;div&gt;时间片轮转&lt;/div&gt;&lt;div&gt;超时计时&lt;/div&gt;&lt;div&gt;延时结束&lt;/div&gt;" vertex="1">
